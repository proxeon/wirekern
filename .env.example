# Copy to .env (gitignored). The CLI does not auto-load this file.
#   cp .env.example .env
#   set -a && . ./.env && set +a

# Threads use-case credentials (Use Cases → Access the Threads API → Settings).
# Not the Facebook App ID / App secret on App settings → Basic.
WIREKERN_THREADS_CLIENT_ID=
WIREKERN_THREADS_CLIENT_SECRET=
WIREKERN_THREADS_REDIRECT_URI=https://example.com/callback

# Optional reviewable Threads scheduling app (`wirekern-threads-app`).
# Use a real public HTTPS origin; the redirect URI above must be exactly:
#   $WIREKERN_THREADS_APP_PUBLIC_URL/auth/threads/callback
# Keep its data directory outside this repository and owner-only.
WIREKERN_THREADS_APP_PUBLIC_URL=
WIREKERN_THREADS_APP_DATA_DIR=
# Displayed on the public privacy policy; required when the app starts.
WIREKERN_THREADS_SUPPORT_EMAIL=

# Bluesky: handle + app password (bsky.app → Settings → Privacy and security → App passwords).
# Not the account login password.
WIREKERN_BSKY_HANDLE=
WIREKERN_BSKY_APP_PASSWORD=

# Meta Ads credentials (App settings → Basic: Facebook App ID / App secret).
# Unlike Threads, these ARE the App settings → Basic values.
WIREKERN_META_ADS_CLIENT_ID=
WIREKERN_META_ADS_CLIENT_SECRET=
WIREKERN_META_ADS_REDIRECT_URI=https://example.com/callback

# Facebook Pages organic-publishing credentials (same Meta App settings may
# be reused, but this connector owns Page scopes and needs its own re-auth).
WIREKERN_FACEBOOK_PAGES_CLIENT_ID=
WIREKERN_FACEBOOK_PAGES_CLIENT_SECRET=
WIREKERN_FACEBOOK_PAGES_REDIRECT_URI=https://example.com/callback

# Instagram organic-publishing credentials (Meta developer dashboard →
# Manage messaging & content on Instagram → Instagram Login settings).
# This uses the directly authorized professional Instagram account, not a
# Facebook Page token or Meta Ads credential.
WIREKERN_INSTAGRAM_CLIENT_ID=
WIREKERN_INSTAGRAM_CLIENT_SECRET=
WIREKERN_INSTAGRAM_REDIRECT_URI=https://example.com/callback

# LinkedIn member text-post credentials (LinkedIn Developer Portal → Auth).
# Enable both Share on LinkedIn and Sign in with LinkedIn using OpenID Connect
# before authorizing. These values configure the application; the member token
# is stored separately in Wirekern's local vault by `wirekern auth linkedin`.
WIREKERN_LINKEDIN_CLIENT_ID=
WIREKERN_LINKEDIN_CLIENT_SECRET=
WIREKERN_LINKEDIN_REDIRECT_URI=https://example.com/callback

# X API v2 OAuth 2.0 application credentials (X Developer Console → App).
# Wirekern uses Authorization Code + PKCE; the client secret is retained in
# app config for parity but is intentionally not sent in PKCE token exchange.
WIREKERN_X_CLIENT_ID=
WIREKERN_X_CLIENT_SECRET=
WIREKERN_X_REDIRECT_URI=https://example.com/callback

# WhatsApp Cloud uses a permanent System User token saved through
# `wirekern auth whatsapp_cloud --token …`, not an OAuth redirect. These are
# application settings for the sender and signed inbound webhook parser.
WIREKERN_WHATSAPP_PHONE_NUMBER_ID=
WIREKERN_WHATSAPP_APP_SECRET=
